import pandas as pd
import matplotlib.pyplot as plt
df = pd.DataFrame({
    "team": ["CSK", "MI", "RCB", "KKR"],
    "Runs": [195, 150, 200, 170]
})

print(df)
plt.bar(df["team"], df["Runs"])
plt.xlabel("Team")
plt.ylabel("Runs")
plt.title("IPL Team Runs")
plt.show()

